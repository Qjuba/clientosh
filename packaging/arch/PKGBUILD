# Maintainer: clientosh <clientosh@localhost>
# Build clientosh for Arch Linux. Run `makepkg -si` in this directory.
# The version is kept in sync with the CPack tag in CMakeLists.txt; bump it
# together with each release.

pkgname=clientosh
pkgver=1.0.1
pkgrel=1
pkgdesc="Raw dark-gray SSH client (Qt 6 + libssh)"
arch=('x86_64')
url="https://github.com/clientosh/clientosh"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'libssh' 'openssl')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/hdmain/clientosh/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_DATADIR=share
  cmake --build build -j "$(nproc)"
}

package() {
  DESTDIR="${pkgdir}" cmake --install build --prefix "${pkgdir}/usr"
}
